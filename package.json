{
  "name": "smart-commute",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "tsx --test \"lib/**/*.test.ts\"",
    "test:contracts": "tsx --test \"lib/live/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test -g accessibility",
    "test:release": "npm run lint && npm run test:unit && npm run build && npm run test:e2e",
    "providers:check": "tsx --env-file-if-exists=.env.local scripts/check-live-providers.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:configure-cron": "tsx --env-file-if-exists=.env.local scripts/configure-supabase-cron.ts"
  },
  "dependencies": {
    "lucide-react": "latest",
    "maplibre-gl": "latest",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "latest",
    "react-dom": "latest",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/web-push": "^3.6.4",
    "eslint": "latest",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "^6.2.5",
    "tsx": "latest",
    "typescript": "latest"
  }
}

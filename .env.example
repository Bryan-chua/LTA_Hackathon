# Server-side only
LTA_DATAMALL_ACCOUNT_KEY=
GOOGLE_MAPS_API_KEY=
ONEMAP_ACCESS_TOKEN=
DATA_MODE=replay
LIVE_PROVIDERS_ENABLED=false
DATABASE_URL=
MIGRATION_DATABASE_URL=
APP_BASE_URL=https://your-cloud-run-service.run.app
GCP_SCHEDULER_SERVICE_ACCOUNT=
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com
PUSH_ENABLED=false
PUSH_TEST_ENABLED=false

# Optional single-process synthetic demand demo. Enabled by default in development;
# disabled in production unless explicitly true. Not a live telemetry deployment.
DEMAND_DEMO_ENABLED=

# Reliability forecast. Replay uses a visibly labelled synthetic model;
# live journeys remain on deterministic fallback until a calibrated artifact exists.
RELIABILITY_FORECAST_UI_ENABLED=true
RELIABILITY_OBSERVATION_ENABLED=true
RELIABILITY_MODEL_ENABLED=false
RELIABILITY_MODEL_SHADOW_MODE=true
RELIABILITY_MODEL_URI=
RELIABILITY_MODEL_VERSION=
RELIABILITY_MIN_GLOBAL_LABELS=500
RELIABILITY_MIN_SIMILAR_LABELS=30
RELIABILITY_MIN_PERSONAL_LABELS=20

# Safe public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
NEXT_PUBLIC_APP_ENV=development
